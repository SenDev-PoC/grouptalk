# Supabase를 비워 두면 브라우저 데모 모드로 실행된다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API 응답에 LiveKit URL이 없을 때만 사용하는 fallback이다.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# 같은 개발 PC 브라우저: http://localhost:8000/livekit/token
# 휴대폰: http://<개발-PC-LAN-IP>:8000/livekit/token
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:8000/livekit/token

# 배포 후 회원가입 422가 나면 Supabase Authentication → URL Configuration에
# Site URL과 Redirect URLs로 https://<배포-도메인> 과 https://<배포-도메인>/login 을 넣는다.
